<?xml version="1.0" encoding="windows-1252"?>
<project name="SOA_MDS_DEPLOY" default="deploy-all">

  <property file="build.properties"/>

  <!-- ********* PACKAGE COMPOSITE ******** -->
  <target name="package-composite">
      <echo>Packaging Composite ${compositeName}</echo>

      <ant antfile="${oracle.home}/soa/bin/ant-sca-package.xml">
          <property name="oracle.home" value="${oracle.home}"/>
          <property name="compositeName" value="${compositeName}"/>
          <property name="compositeDir" value="${compositeDir}"/>
          <property name="revision" value="${revision}"/>
      </ant>
  </target>


  <!-- ********* DEPLOY COMPOSITE ******** -->
  <target name="deploy-composite" depends="package-composite">
      <echo>Deploying Composite ${compositeName}</echo>

      <ant antfile="${oracle.home}/soa/bin/ant-sca-deploy.xml">
          <property name="oracle.home" value="${oracle.home}"/>
          <property name="sarLocation" value="${sarLocation}"/>
          <property name="serverURL" value="${serverURL}"/>
          <property name="user" value="${user}"/>
          <property name="password" value="${password}"/>
          <property name="overwrite" value="true"/>
      </ant>
  </target>


  <!-- ********* DEPLOY MDS ******** -->
  <target name="deployMDS">
      <echo>Deploying MDS...</echo>

      <delete dir="deploy"/>
      <mkdir dir="deploy"/>

      <zip destfile="deploy/mds.jar" compress="false">
          <fileset dir="${mds.repository}/apps"/>
      </zip>

      <ant antfile="${oracle.home}/soa/bin/ant-sca-deploy.xml">
          <property name="oracle.home" value="${oracle.home}"/>
          <property name="serverURL" value="${serverURL}"/>
          <property name="user" value="${user}"/>
          <property name="password" value="${password}"/>
          <property name="overwrite" value="true"/>
          <property name="sarLocation" value="deploy/mds.jar"/>
      </ant>

      <echo>MDS deployment completed</echo>
  </target>


  <!-- ******** RUN EVERYTHING ******** -->
  <target name="deploy-all" depends="deployMDS,deploy-composite"/>

</project>